+"""Multi-currency account ledger.
+
+REQ-003: Accounts hold per-currency Decimal balances. Supported
+currencies: USD, EUR, JPY.
+"""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+from money import quantize, to_decimal, validate_currency
+
+
+class Account:
+    """A multi-currency account with per-currency Decimal balances."""
+
+    def __init__(self, owner, balance=0.0):
+        if not owner:
+            raise ValueError("owner must be a non-empty string")
+        opening = to_decimal(balance)
+        opening = quantize(opening, "USD")
+        if opening < 0:
+            raise ValueError("opening balance must be >= 0")
+        self.owner = owner
+        self._balances = {
+            "USD": opening,
+            "EUR": Decimal("0.00"),
+            "JPY": Decimal("0"),
+        }
+
+    @property
+    def balance(self):
+        """Current USD balance as a Decimal."""
+        return self._balances["USD"]
+
+    @property
+    def balances(self):
+        """Dict copy of all per-currency balances."""
+        return dict(self._balances)
+
+    def deposit(self, amount, currency="USD"):
+        """Add funds in the given currency; returns the new balance."""
+        validate_currency(currency)
+        value = to_decimal(amount)
+        value = quantize(value, currency)
+        if value <= 0:
+            raise ValueError("deposit amount must be positive")
+        self._balances[currency] += value
+        return self._balances[currency]
+
+    def withdraw(self, amount, currency="USD"):
+        """Remove funds in the given currency; returns the new balance."""
+        validate_currency(currency)
+        value = to_decimal(amount)
+        value = quantize(value, currency)
+        if value <= 0:
+            raise ValueError("withdrawal amount must be positive")
+        if value > self._balances[currency]:
+            raise ValueError("insufficient funds")
+        self._balances[currency] -= value
+        return self._balances[currency]
+
+    def to_dict(self):
+        """Serialize to the version-2 record schema."""
+        return {
+            "owner": self.owner,
+            "balances": {k: str(v) for k, v in self._balances.items()},
+        }
+
+    @classmethod
+    def from_dict(cls, data):
+        """Rebuild an account from a version-2 record."""
+        owner = data["owner"]
+        balances = data.get("balances", {})
+        acc = cls.__new__(cls)
+        acc.owner = owner
+        acc._balances = {}
+        for cur in ("USD", "EUR", "JPY"):
+            if cur in balances:
+                acc._balances[cur] = Decimal(balances[cur])
+            else:
+                acc._balances[cur] = (
+                    Decimal("0.00") if cur != "JPY" else Decimal("0")
+                )
+        return acc
+
+    def __eq__(self, other):
+        if not isinstance(other, Account):
+            return NotImplemented
+        return self.owner == other.owner and self._balances == other._balances
+
+    def __repr__(self):
+        return "Account(owner=%r, balances=%r)" % (self.owner, self._balances)
+
+
+def transfer(source, target, amount, currency="USD"):
+    """Move funds between two accounts in the given currency."""
+    validate_currency(currency)
+    value = to_decimal(amount)
+    value = quantize(value, currency)
+    if value <= 0:
+        raise ValueError("transfer amount must be positive")
+    source.withdraw(value, currency)
+    target.deposit(value, currency)
+    return value
