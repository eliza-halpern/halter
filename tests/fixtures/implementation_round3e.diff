+"""Shared money helpers: type conversion, rounding, and currency validation.
+
+REQ-002: Provides the single money concept used across the ledger.
+"""
+
+from __future__ import annotations
+
+from decimal import Decimal, ROUND_HALF_UP
+
+SUPPORTED_CURRENCIES = ("USD", "EUR", "JPY")
+
+
+def to_decimal(value):
+    """Convert int, str, Decimal, or float to Decimal.
+
+    Floats are converted via Decimal(str(value)) to avoid binary
+    floating-point artifacts. Any other type raises TypeError.
+    """
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, int):
+        return Decimal(value)
+    if isinstance(value, str):
+        return Decimal(value)
+    if isinstance(value, float):
+        return Decimal(str(value))
+    raise TypeError(
+        "amount must be int, str, Decimal, or float, got %s"
+        % type(value).__name__
+    )
+
+
+def quantize(amount, currency):
+    """Quantize a Decimal to the appropriate places for the currency.
+
+    USD and EUR: 2 decimal places. JPY: 0 decimal places.
+    Uses ROUND_HALF_UP.
+    """
+    validate_currency(currency)
+    if currency == "JPY":
+        return amount.quantize(Decimal("1"), rounding=ROUND_HALF_UP)
+    return amount.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+
+
+def validate_currency(currency):
+    """Raise ValueError if currency is not one of the supported currencies.
+
+    The error message names all supported currencies: USD, EUR, and JPY.
+    """
+    if currency not in SUPPORTED_CURRENCIES:
+        raise ValueError(
+            "unsupported currency %r; supported currencies are USD, EUR, and JPY"
+            % (currency,)
+        )
