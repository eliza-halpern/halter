+"""Per-currency fee schedule.
+
+REQ-004: Fees vary by currency: USD 0.30, EUR 0.25, JPY 30.
+"""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+from money import quantize, to_decimal, validate_currency
+
+FEES = {
+    "USD": Decimal("0.30"),
+    "EUR": Decimal("0.25"),
+    "JPY": Decimal("30"),
+}
+
+
+def fee_for(amount, currency="USD"):
+    """Return the fee for the given currency.
+
+    Validates the amount type and currency. The fee is a fixed
+    value per currency regardless of the amount.
+    """
+    validate_currency(currency)
+    to_decimal(amount)
+    return FEES[currency]
+
+
+def apply_fee(amount, currency="USD"):
+    """Deduct the currency fee; returns the net amount as Decimal.
+
+    Raises ValueError when the quantized amount is below the fee.
+    """
+    validate_currency(currency)
+    value = to_decimal(amount)
+    value = quantize(value, currency)
+    if value < FEES[currency]:
+        raise ValueError(
+            "amount %s is below the fee %s for %s"
+            % (value, FEES[currency], currency)
+        )
+    net = value - FEES[currency]
+    return quantize(net, currency)
+
+
+def total_fees(count, currency="USD"):
+    """Return the combined fees for count transactions in the given currency.
+
+    Raises TypeError for non-int counts and ValueError for negative counts.
+    """
+    validate_currency(currency)
+    if isinstance(count, bool) or not isinstance(count, int):
+        raise TypeError("count must be an int")
+    if count < 0:
+        raise ValueError("count must be >= 0")
+    return quantize(FEES[currency] * count, currency)
+
+
+# Keep FLAT_FEE as a deprecated alias for backward compatibility.
+FLAT_FEE = FEES["USD"]
+
+
+__all__ = ["FEES", "FLAT_FEE", "apply_fee", "fee_for", "total_fees"]
